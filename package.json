{
  "name": "focuna-v2",
  "version": "2.0.0-pre.1",
  "private": true,
  "description": "Rules-first Gmail decision assistant v2 domain contracts",
  "type": "commonjs",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "build:apps-script": "esbuild packages/domain/src/index.ts --bundle --format=iife --global-name=FocunaDomain --target=es2020 --platform=browser --outfile=dist/apps-script/focuna-domain.gs",
    "test": "npm run clean && npm run typecheck && npm run build && npm run build:apps-script && node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
