{
  "name": "focuna-v2",
  "version": "2.0.0-pre.1",
  "private": true,
  "description": "Rules-first Gmail decision assistant v2 domain contracts",
  "type": "commonjs",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.google.json",
    "build": "tsc",
    "db:migrate": "node apps/decision-worker/src/migrate.mjs",
    "db:provision-question-sets": "node apps/decision-worker/src/provision-question-sets.mjs",
    "build:apps-script": "esbuild packages/domain/src/index.ts --bundle --format=iife --global-name=FocunaDomain --target=es2020 --platform=browser --outfile=dist/apps-script/focuna-domain.gs && esbuild apps/google/src/sha256.ts --bundle --format=iife --global-name=FocunaGoogleSha256 --target=es2020 --platform=browser --outfile=dist/apps-script/google-sha256.gs",
    "test": "npm run clean && npm run typecheck && npm run build && npm run build:apps-script && node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^13.2.0"
  }
}
